    {
      "name": "UNT",
      "mandatory": true,
      "repeatable": true,
      "position": 8,
      "description": "Nachrichtenabschluss"
    },
    {
      "name": "UNZ",
      "mandatory": true,
      "repeatable": false,
      "position": 9,
      "description": "Interchange-Abschluss"
    }
