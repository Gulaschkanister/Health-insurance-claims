    {
      "name": "UNH",
      "mandatory": true,
      "repeatable": true,
      "position": 2,
      "description": "Nachrichtenkopf pro Nachricht"
    },
    {
      "name": "FKT",
      "mandatory": true,
      "repeatable": false,
      "position": 3,
      "description": "IK-Bezug und Verarbeitungskennzeichen"
    },
    {
      "name": "REC",
      "mandatory": true,
      "repeatable": false,
      "position": 4,
      "description": "Rechnungsdaten"
    },
    {
      "name": "UST",
      "mandatory": false,
      "repeatable": false,
      "position": 5,
      "description": "Umsatzsteuer-Informationen (optional)"
    },
    {
      "name": "GES",
      "mandatory": true,
      "repeatable": true,
      "position": 6,
      "description": "Summen (mind. 2x: Status 00 und 99)"
