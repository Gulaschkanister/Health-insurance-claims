{
  "schemaVersion": "1.0",
  "profileId": "SLGA-v21",
  "description": "Summen-/Begleitdaten - Profil für Sammelabrechnung",
  "version": "V21",
  "nachrichtentyp": "SLGA",
  "segments": [
    {
      "name": "UNB",
      "mandatory": true,
      "repeatable": false,
      "position": 1,
