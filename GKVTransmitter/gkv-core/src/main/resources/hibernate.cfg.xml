<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration SYSTEM
"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
   <session-factory>
      <!--
         Verbindungs-URL und Schema-Modus werden absichtlich NICHT hier gesetzt.
         Beide kommen aus DatabaseSettings und werden vom SessionFactoryProvider
         gesetzt, damit sich Produktivbetrieb und Tests unterschiedliche
         Datenbanken geben koennen.

         Frueher stand hier hbm2ddl.auto=create - das legt das Schema bei jedem
         Start neu an und verwirft dabei saemtliche gespeicherten Stammdaten.
         Der Standard ist jetzt "update" (siehe DatabaseSettings).
      -->
      <property name="hibernate.dialect">org.hibernate.community.dialect.SQLiteDialect</property>
      <property name="hibernate.connection.driver_class">org.sqlite.JDBC</property>

      <!--
         autocommit war auf true gesetzt. Damit wurde jede Anweisung sofort
         wirksam und ein Rollback konnte nichts mehr zuruecknehmen - die
         Transaktionsklammern im Repository waren wirkungslos.
      -->
      <property name="hibernate.connection.autocommit">false</property>

      <property name="hibernate.connection.pool_size">5</property>
      <property name="hibernate.jdbc.batch_size">20</property>

      <!--
         busy_timeout, journal_mode und foreign_keys stehen in der Verbindungs-URL
         (siehe DatabaseSettings) - als Hibernate-Property wuerde SQLite sie
         stillschweigend ignorieren.
      -->

      <!-- SQL-Ausgabe nur bei Bedarf zuschalten, sie ueberflutet sonst die Konsole. -->
      <property name="hibernate.show_sql">false</property>
      <property name="hibernate.format_sql">true</property>

      <!-- Die entity-Klassen registriert der SessionFactoryProvider typsicher. -->
   </session-factory>
</hibernate-configuration>
