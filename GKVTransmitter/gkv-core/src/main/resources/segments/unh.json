{
  "schemaVersion": "1.0",
  "version": "V21",
  "segmentType": "UNH",
  "description": "Nachrichtenkopf",
  "fields": [
    {
      "position": 1,
      "name": "Nachrichten-Referenznummer",
      "type": "STRING",
      "maxLength": 14,
      "mandatory": true,
      "example": "00001",
      "description": "Fortlaufende Nummer der Nachricht zwischen UNB und UNZ",
      "inputType": "STRING",
      "internal": true
    },
    {
      "position": 2,
      "name": "Nachrichtentyp",
      "description": "Nachrichtentyp mit Version und Release",
      "type": "COMPOSITE",
      "mandatory": true,
      "components": [
        {
          "position": 1,
          "name": "Nachrichttyp-Code",
          "type": "STRING",
          "maxLength": 6,
          "mandatory": true,
          "example": "SLGA",
          "validation": {
            "values": {
              "SLGA": "Summen-/Begleitdaten",
              "SLLA": "Falldaten/Leistungsdaten"
            }
          },
          "inputType": "CODE",
          "internal": true
        },
        {
          "position": 2,
          "name": "Nachrichtentyp-Version",
          "type": "INTEGER",
          "maxLength": 3,
          "mandatory": true,
          "example": "21",
          "description": "Version des Nachrichtentyps",
          "inputType": "NUMBER",
          "internal": true
        },
        {
          "position": 3,
          "name": "Release",
          "type": "INTEGER",
          "maxLength": 3,
          "mandatory": true,
          "example": "0",
          "description": "Release-Nummer",
          "inputType": "NUMBER",
          "internal": true
        },
        {
          "position": 4,
          "name": "Controlling Agency",
          "type": "STRING",
          "maxLength": 2,
          "mandatory": true,
          "example": "0",
          "description": "Kontrollstelle",
          "inputType": "STRING",
          "internal": true
        }
      ],
      "inputType": "STRING",
      "internal": true
    }
  ]
}