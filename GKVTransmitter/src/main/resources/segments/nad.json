{
  "schemaVersion": "1.0",
  "version": "V21",
  "segmentType": "NAD",
  "description": "Name/Adresse der versicherten Person (detailliert, nur für SLLA)",
  "note": "Folgt auf INV. Wenn INV-Status leer ist: NAD-Anschrift ist vollständig erforderlich",
  "fields": [
    {
      "position": 1,
      "name": "Nachname",
      "type": "STRING",
      "maxLength": 35,
      "mandatory": true,
      "example": "MUSTERMANN",
      "description": "Familienname des Versicherten",
      "fieldArt": "M",
      "inputType": "STRING",
      "internal": false
    },
    {
      "position": 2,
      "name": "Vorname",
      "type": "STRING",
      "maxLength": 35,
      "mandatory": true,
      "example": "ANNA",
      "description": "Vorname des Versicherten",
      "fieldArt": "M",
      "inputType": "STRING",
      "internal": false
    },
    {
      "position": 3,
      "name": "Geburtsdatum",
      "type": "INTEGER",
      "maxLength": 8,
      "mandatory": true,
      "example": "19900101",
      "format": "YYYYMMDD",
      "description": "Geburtsdatum des Versicherten",
      "fieldArt": "M",
      "inputType": "DATE",
      "internal": false
    },
    {
      "position": 4,
      "name": "Straße",
      "type": "STRING",
      "maxLength": 35,
      "mandatory": true,
      "example": "MUSTERSTRASSE 1",
      "description": "Postanschrift: Straßenname und Hausnummer",
      "fieldArt": "M",
      "inputType": "STRING",
      "internal": false
    },
    {
      "position": 5,
      "name": "Postleitzahl",
      "type": "STRING",
      "maxLength": 10,
      "mandatory": true,
      "example": "12345",
      "description": "Postleitzahl",
      "fieldArt": "M",
      "inputType": "NUMBER",
      "internal": false
    },
    {
      "position": 6,
      "name": "Stadt",
      "type": "STRING",
      "maxLength": 35,
      "mandatory": true,
      "example": "MUSTERSTADT",
      "description": "Ort/Stadt",
      "fieldArt": "M",
      "inputType": "STRING",
      "internal": false
    }
  ],
  "validationRule": "Wenn INV.Versichertenstatus (Pos 2) leer ist, dann muss NAD mit kompletter Adresse geliefert werden"
}