@startuml GKVTransmitter_Uebersicht
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam componentStyle rectangle

package "Praesentation" as presentation {
  [JavaFX UI]
}
package "Anwendung" as application {
  [Controller / Bootstrap]
}
package "Parser und Definitionen" as parsing {
  [JSON Parser]
  [Global Definitions]
}
package "Domaene" as domain {
  [Entity und Model]
  [Segmentdefinitionen]
}
package "DTA-Verarbeitung" as dta {
  [DTA Factory]
  [Dispatch Service]
}
package "Versand" as dispatch {
  [Transport]
  [Kassen-Endpunkte]
}
package "Persistenz" as persistence {
  [Hibernate / SQLite]
}
package "Validierung" as validation {
  [Field Validator]
  [Tag-Konfiguration]
}

presentation --> application
presentation --> domain
application --> parsing
application --> persistence
parsing --> domain
domain --> validation
application --> dta
dta --> domain
dta --> dispatch
domain --> persistence

legend right
  Paketuebersicht des GKVTransmitters
  Pfeil = Abhaengigkeit zwischen Verantwortungsbereichen
  Details befinden sich in den drei Detaildiagrammen.
endlegend
@enduml
