@startuml GKVTransmitter_Vision_ER
hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam ranksep 60
skinparam nodesep 40
skinparam class {
  BackgroundColor White
  BorderColor #4A5A6A
  ArrowColor #4A5A6A
}
skinparam package {
  BackgroundColor #FAFBFC
  BorderColor #8A99A8
}

title Erstes Datenmodell — was dauerhaft festgehalten werden muss

legend top left
  Entwurf zur Vision. **Fachliche Sicht**, keine Tabellen:
  Schlüssel sind hier Gedanken, keine Spalten.
  PK = woran sich ein Eintrag erkennen lässt · FK = worauf er verweist
  Was daraus im Schema wurde, zeigt Teil 07.
endlegend

package "Stammdaten — werden gepflegt" {

  entity "Leistungserbringerin" as LE {
    **PK** Kennung
    --
    Name
    Anschrift
    Institutionskennzeichen
    Steuernummer
  }

  entity "Versicherte Person" as VP {
    **PK** Kennung
    --
    Name
    Geburtsdatum
    Anschrift
    --
    Versichertennummer
    Versichertenstatus
    **FK** Kasse
  }

  entity "Krankenkasse" as KK {
    **PK** Institutionskennzeichen
    --
    Name
    **FK** Annahmestelle
  }

  entity "Annahmestelle" as AS {
    **PK** Institutionskennzeichen
    --
    Bezeichnung
    Zugangsweg
  }

  entity "Leistungsfall" as LF {
    **PK** Kennung
    --
    Bezeichnung
    Zeitraum
    Anzahl der Einheiten
    **FK** Leistungserbringerin
    **FK** Leistungsbeschreibung
  }

  entity "Leistungsbeschreibung" as LB {
    **PK** Kennung
    --
    Bezeichnung
    Leistungsbereich
    Abrechnungsposition
    Tarifkennzeichen
    Betrag je Einheit
    Umsatzsteuersatz
  }
}

package "Bewegungsdaten — entstehen im Betrieb" {

  entity "Leistungsnachweis" as LN {
    **PK** Kennung
    --
    **FK** Leistungsfall
    **FK** Versicherte Person
    erbrachte Einheiten
  }

  entity "Abrechnung" as AB {
    **PK** Kennung
    --
    Belegnummer
    Abrechnungszeitraum
    Betrag
    **FK** Leistungsnachweis
    **FK** Lieferung
  }

  entity "Lieferung" as LI {
    **PK** Kennung
    --
    laufende Nummer
    Art: Test · Erprobung · Echt
    Dateiname
    **FK** Annahmestelle
  }

  entity "Befund" as BE {
    **PK** Kennung
    --
    **FK** Lieferung
    Stufe
    Fundstelle
    Beschreibung
  }

  entity "Rückmeldung" as RM {
    **PK** Kennung
    --
    **FK** Lieferung
    Einstufung
    Text
  }
}

package "Betriebsdaten — einmal eingerichtet" {

  entity "Einstellung" as EI {
    **PK** Schlüssel
    --
    Wert
  }
  note bottom of EI
    Ablageort, Testkennzeichen,
    Voreinstellungen.

    Ein **Schlüssel-Wert-Vorrat** statt
    fester Spalten: eine neue Einstellung
    soll keine Änderung am Datenmodell
    verlangen.
  end note

  entity "Zähler" as ZA {
    **PK** Bezeichnung
    --
    nächster Wert
  }
  note bottom of ZA
    Die laufende Nummer einer Lieferung
    darf sich **nie wiederholen** — auch
    nicht nach einem Neustart oder einem
    abgebrochenen Lauf.

    Deshalb gehört sie in die Ablage und
    nicht in den Arbeitsspeicher.
  end note
}

LE ||--o{ LF
LB ||--o{ LF
LF ||--|{ LN
VP ||--o{ LN
KK ||--o{ VP
AS ||--|{ KK

LN ||--|| AB
LI ||--|{ AB
AS ||--o{ LI
LI ||--o{ BE
LI ||--o| RM

note as regel #FFF8DC
  **Zwei Festlegungen, die hier schon feststehen**

  **Eine Abrechnung gehört immer zu genau einer Lieferung.**
  Sonst ließe sich später nicht beantworten, was eigentlich
  wohin gegangen ist — und genau das braucht man, wenn eine
  Zurückweisung eintrifft.

  **Ein Befund hängt an der Lieferung, nicht an der Abrechnung.**
  Manche Beanstandungen betreffen die Lieferung als Ganzes:
  Zähler, Summen, Rahmen. Sie hätten an keiner einzelnen
  Abrechnung einen Platz.
end note

note as bereich #EAF3FA
  **Wo ein neuer Leistungsbereich andockt**

  Nur die **Leistungsbeschreibung** trägt, was sich je
  Bereich unterscheidet: Leistungsbereich,
  Abrechnungsposition, Tarifkennzeichen.

  Alles übrige im Bild — Personen, Fälle, Lieferungen,
  Befunde — bleibt gleich. Ein weiterer Bereich ist
  damit ein Eintrag, kein Umbau.
end note

regel .. BE
bereich .. LB

@enduml
